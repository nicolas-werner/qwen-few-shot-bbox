# --- required ---------------------------------------------------------------
# OpenRouter key. Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- optional ---------------------------------------------------------------
# qwen/qwen3.8-max        proprietary hosted version (default)
# qwen/qwen3.8-2.4t-a95b  the open-weight MoE release
# OPENROUTER_MODEL=qwen/qwen3.8-max

# OpenRouter attribution headers — cosmetic, only affect their public rankings.
# OPENROUTER_SITE_URL=
# OPENROUTER_SITE_NAME=

# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
